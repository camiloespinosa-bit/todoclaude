# Copia este archivo como .env y llena los valores.
# Solo las variables que empiezan por VITE_ llegan al navegador.
# Usa la llave "anon" (pública) de Supabase. NUNCA pongas aquí la service_role.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-llave-anon
VITE_LLAVE_BREB=tu-llave-bre-b
